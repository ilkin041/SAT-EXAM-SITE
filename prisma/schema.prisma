generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  STUDENT
  ADMIN
}

enum TestMode {
  ADAPTIVE
  LINEAR
}

enum SectionType {
  READING_WRITING
  MATH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum QuestionType {
  MULTIPLE_CHOICE
  STUDENT_PRODUCED_RESPONSE
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
}

enum AnnotationColor {
  YELLOW
  BLUE
  PINK
}

enum AttemptEventType {
  BLUR
  FOCUS
  FULLSCREEN_EXIT
  FULLSCREEN_ENTER
}

enum ImagePosition {
  TOP
  INLINE
}

/// Coarse device class derived from the request User-Agent by
/// `deviceTypeFromUserAgent` (`src/lib/device.ts`). Deliberately coarse: the
/// question T10.1 has to answer is "does mobile matter", not "which phone".
enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  BOT
  UNKNOWN
}

// ---------- Models ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testsCreated Test[]               @relation("TestCreatedBy")
  attempts     TestAttempt[]
  resetTokens  PasswordResetToken[]
  groups       Group[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model Test {
  id                String   @id @default(cuid())
  title             String
  description       String?
  mode              TestMode @default(ADAPTIVE)
  isPublic          Boolean  @default(false)
  adaptiveThreshold Float    @default(0.6)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy User?         @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sections  Section[]
  attempts  TestAttempt[]
  groups    Group[]

  @@index([createdById])
}

model Section {
  id               String      @id @default(cuid())
  testId           String
  type             SectionType
  order            Int
  module1TimeLimit Int // seconds
  module2TimeLimit Int // seconds

  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  modules Module[]

  @@unique([testId, order])
  @@index([testId])
}

model Module {
  id           String     @id @default(cuid())
  sectionId    String
  moduleNumber Int // 1 or 2
  difficulty   Difficulty // module1 = MIXED, module2 = EASY or HARD (or MIXED in linear mode)

  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  moduleQuestions ModuleQuestion[]
  moduleResults   ModuleResult[]

  @@index([sectionId])
}

/// A College Board content domain. Eight rows, seeded from
/// `src/lib/question-taxonomy.ts` by `npm run db:seed-taxonomy`. Ids are
/// hand-written slugs so a fresh database gets the same ones as this one.
model Domain {
  id          String      @id
  name        String      @unique
  sectionType SectionType
  /// Authoring order within the section — the order a `Select` lists them in.
  sortOrder   Int

  skills    Skill[]
  questions Question[]

  @@index([sectionType])
}

/// A skill within exactly one domain. Single-domain ownership is College
/// Board's model and is what lets `SkillMastery` (T8.1) roll a skill up to a
/// domain without a second join.
model Skill {
  id        String @id
  domainId  String
  name      String
  sortOrder Int

  domain    Domain     @relation(fields: [domainId], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([domainId, name])
  @@index([domainId])
}

/// A question whose pre-T2.2 free-text taxonomy could not be mapped onto the
/// controlled vocabulary. The original strings are kept verbatim so a tutor
/// retagging the question can see what the author meant — the alternative was
/// dropping them, and a guess here would feed T8.1's mastery model a tag nobody
/// wrote. Resolved by setting `Question.skillId`, which clears the row.
model TaxonomyReview {
  id            String   @id @default(cuid())
  questionId    String   @unique
  /// Verbatim `Question.domain` at migration time.
  legacyDomain  String
  /// Verbatim `Question.skill` at migration time. NULL means it was never tagged.
  legacySkill   String?
  /// Why it could not be mapped — shown to whoever works the queue.
  reason        String
  createdAt     DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Question {
  id              String        @id @default(cuid())
  contentHash     String?
  /// Which SAT section this question belongs to — splits the bank into Math
  /// and Reading-and-Writing. Enforced by `assignQuestionToModule` so a
  /// MATH question can't be dropped into an R&W module by mistake.
  sectionType     SectionType
  type            QuestionType
  /// Controlled vocabulary since T2.2 — there is no free-text domain column.
  domainId        String
  /// NULL is legal: an untagged question, or one whose legacy value went to
  /// `TaxonomyReview`. Every student-facing surface groups by domain, so a
  /// missing skill degrades nothing before T8.1.
  skillId         String?
  difficulty      Difficulty    @default(MEDIUM)
  passage         String? // sanitized HTML, optional (R&W)
  stem            String // sanitized HTML
  imageUrl        String?
  /// Where the image renders relative to the stem.
  ///   TOP    → above the stem
  ///   INLINE → between the stem and the answer choices (default)
  imagePosition   ImagePosition @default(INLINE)
  /// Optional cap on rendered image width in pixels. NULL → browser default.
  imageMaxWidth   Int?
  /// JSON: [{ label: 'A'|'B'|'C'|'D', text: string }]
  choices         Json?
  correctAnswer   String
  /// JSON: string[] — alternate accepted forms for SPR
  acceptedAnswers Json?
  explanation     String?
  /// T3.3: this question may be shown to a logged-out visitor in the landing
  /// page's three-question demo.
  ///
  /// It is a *licensing* flag, not a publish state. Setting it asserts the
  /// question is originally authored and safe to expose publicly — the bank
  /// references "Official SAT Practice Test 4", so the default is false and
  /// nothing is opted in by a bulk operation or an import. T10.3's draft /
  /// published state is a different axis and must not be folded into this one:
  /// a question can be published to students and still not licensable to the
  /// open web.
  publicDemo      Boolean       @default(false)
  /// JSON: the question's rich content with `$…$` LaTeX already run through
  /// KaTeX and sanitized, written at save time by `renderQuestionHtml`.
  /// Shape is `RenderedQuestionHtml` in `src/lib/rendered-question.ts`:
  /// `{ v, stem, passage, explanation, choices: [{ label, html }] }`.
  ///
  /// This exists so student surfaces never ship the KaTeX renderer. NULL is a
  /// legal state — a record written before the backfill, or by a code path
  /// that predates this column — and every reader falls back to rendering on
  /// the server. Bump `v` and re-run the backfill when the renderer changes.
  renderedHtml    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  domain            Domain           @relation(fields: [domainId], references: [id], onDelete: Restrict)
  skill             Skill?           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  taxonomyReview    TaxonomyReview?
  moduleAssignments ModuleQuestion[]
  answers           Answer[]
  annotations       Annotation[]

  @@index([sectionType])
  @@index([domainId])
  @@index([skillId])
  @@index([difficulty])
  @@index([contentHash])
  @@index([publicDemo])
}

/// Join table linking a question in the global bank to a specific module of a
/// specific test, with a display `order`. The same Question can appear in many
/// modules (across tests) but only once per module.
model ModuleQuestion {
  id         String   @id @default(cuid())
  moduleId   String
  questionId String
  order      Float
  createdAt  DateTime @default(now())

  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([moduleId, questionId])
  @@index([moduleId])
  @@index([questionId])
}

model TestAttempt {
  id                   String                    @id @default(cuid())
  userId               String? // null = public/anonymous attempt
  testId               String
  startedAt            DateTime                  @default(now())
  completedAt          DateTime?
  currentSectionId     String?
  currentModuleId      String?
  currentQuestionIndex Int                       @default(0)
  /// Server-recorded UTC time the current module started — drives the authoritative timer.
  moduleStartedAt      DateTime?
  /// Authoritative server-side deadline for the current module. Queryable for expiry sweepers.
  moduleDeadlineAt     DateTime?
  /// Set when the student finishes one section and is on the 10-minute break before the next.
  breakStartedAt       DateTime?
  status               AttemptStatus             @default(IN_PROGRESS)
  user                 User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  test                 Test                      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers              Answer[]
  questionSnapshots    AttemptQuestionSnapshot[]
  moduleResults        ModuleResult[]
  annotations          Annotation[]
  events               AttemptEvent[]

  @@index([userId])
  @@index([testId])
  @@index([status])
  @@index([status, moduleDeadlineAt])
}

model AttemptEvent {
  id         String           @id @default(cuid())
  attemptId  String
  type       AttemptEventType
  occurredAt DateTime
  receivedAt DateTime         @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
}

model Answer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  response          String   @default("")
  isCorrect         Boolean  @default(false)
  isMarkedForReview Boolean  @default(false)
  /// JSON: ('A'|'B'|'C'|'D')[]
  eliminatedChoices Json?
  timeSpent         Int      @default(0) // seconds accumulated on this question
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

/// Immutable grading data captured from the same Question row sent to the
/// student. Live question edits can never alter an in-flight attempt's score.
model AttemptQuestionSnapshot {
  id              String       @id @default(cuid())
  attemptId       String
  moduleId        String
  questionId      String
  questionType    QuestionType
  correctAnswer   String
  acceptedAnswers Json?
  createdAt       DateTime     @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, moduleId])
  @@index([questionId])
}

model Annotation {
  id          String          @id @default(cuid())
  attemptId   String
  questionId  String
  /// Character offsets into the passage's plain text.
  startOffset Int
  endOffset   Int
  /// The selected text (denormalized for resilience if offsets shift).
  text        String
  color       AnnotationColor @default(YELLOW)
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

model ModuleResult {
  id           String   @id @default(cuid())
  attemptId    String
  moduleId     String
  correctCount Int
  totalCount   Int
  /// For adaptive Module 1 results: id of the Module 2 the student was routed to.
  routedTo     String?
  createdAt    DateTime @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  module  Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([attemptId, moduleId])
  @@index([attemptId])
}

/// One browser's analytics session, keyed by the `sat_sid` cookie issued in
/// `middleware.ts`. Exists so device and viewport are stored **once** rather
/// than copied onto every event.
///
/// A row is created lazily by the first `track()` of that session, so a visitor
/// who never does anything countable leaves no row at all. `deviceType` and
/// `userAgent` come from the request; `viewportWidth` is the one thing the
/// server cannot know, so a client sends it with the attempt-start request.
model AnalyticsSession {
  id            String     @id
  /// Who this browser was signed in as the first time it produced an event.
  /// NULL for a session that stayed anonymous. Not a FK — analytics must
  /// survive a user deletion without cascading.
  userId        String?
  deviceType    DeviceType @default(UNKNOWN)
  /// CSS pixels, sent by the client at attempt start. NULL until then.
  viewportWidth Int?
  /// Raw UA string, truncated. It is a fingerprinting surface, so it lives
  /// here (one row per browser) and never in `AnalyticsEvent.props`.
  userAgent     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  events AnalyticsEvent[]

  @@index([createdAt])
  @@index([deviceType])
  @@index([userId])
}

/// One product event. Append-only: nothing in the app updates or deletes a row.
///
/// `name` is one of `ANALYTICS_EVENTS` in `src/lib/analytics-events.ts` — a
/// plain String rather than an enum so adding an event is a code change, not a
/// migration, and an unknown name from an old deploy still records.
///
/// **`props` must never contain PII.** `sanitizeProps()` drops identifying keys
/// and anything that looks like an email before the write. See
/// `docs/analytics-events.md`.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  /// NULL for anonymous. Not a FK, same reason as `AnalyticsSession.userId`.
  userId    String?
  sessionId String
  name      String
  props     Json?
  createdAt DateTime @default(now())

  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([name, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
  tests Test[]
}
