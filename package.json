{
  "name": "sat-exam-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint --no-cache --max-warnings=0",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-question-hashes": "tsx scripts/backfill-question-hashes.ts",
    "db:backfill-question-html": "tsx scripts/backfill-question-html.ts",
    "db:finalize-stale-attempts": "tsx scripts/finalize-stale-attempts.ts",
    "db:seed-taxonomy": "tsx scripts/seed-taxonomy.ts",
    "db:seed-demo-questions": "tsx scripts/seed-demo-questions.ts",
    "db:verify-taxonomy": "tsx scripts/verify-taxonomy.ts",
    "db:studio": "prisma studio",
    "gen:reference-sheet": "tsx scripts/generate-reference-sheet.ts",
    "gen:katex-subset": "tsx scripts/subset-katex.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "vitest",
    "analyze": "cross-env ANALYZE=true next build",
    "db:verify-question-html": "tsx scripts/verify-question-html.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "//overrides": "Radix's layer stack lives in a module-level React context, so two copies of react-dismissable-layer means two stacks that cannot see each other. react-select pulled 1.1.19 alongside react-dialog's 1.1.11, and a Select open inside a Dialog then had each think it was the top layer — one Escape dismissed both. npm dedupe will not merge them because each parent pins its own. Keep this until every Radix package agrees on a version on its own.",
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.19"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "next": "14.2.18",
    "next-auth": "5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4",
    "sanitize-html": "^2.13.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "eslint-plugin-sat": "file:./eslint-rules",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
